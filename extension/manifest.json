{
  "manifest_version": 3,
  "name": "HashGuard Sentinel",
  "version": "1.0",
  "description": "Securely evaluate password strength and check data breaches using k-Anonymity.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "HashGuard Sentinel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "https://api.pwnedpasswords.com/*"
  ]
}